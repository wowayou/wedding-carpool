{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-carpool",
  "main": "web/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 不存在的静态路径返回 dist/404.html（状态码 404）
    "not_found_handling": "404-page",
    // 先走 Worker 的路径：接口、方案页、编辑页，以及要做页面访问计数的页面（计数后由 Worker 转给静态文件）
    "run_worker_first": ["/api/*", "/p/*", "/t/*", "/", "/demo", "/guide", "/guide/*", "/for/*", "/privacy", "/about"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ConfigRoom" },
      { "name": "USAGE", "class_name": "Usage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConfigRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Usage"] }
  ],
  "kv_namespaces": [
    { "binding": "DATA", "id": "dd28befbdf1c41cebb15a5fd2f5db89f" }
  ],
  "routes": [
    { "pattern": "carpool.eigentime.org", "custom_domain": true }
  ],
  // 在离 AWS 香港最近的节点运行：Worker 主要时间花在调高德上，放在美国每次要跨太平洋
  "placement": { "region": "aws:ap-east-1" },
  "observability": { "enabled": true }
}
